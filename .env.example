# Rox — шаблон окружения для локальной разработки.
# Скопируй в `.env` (он в .gitignore) и подставь реальные значения.
# Этот файл отслеживается git и публичен: реальные значения сюда не попадают.

# --- Sentry (main-процесс Electron) ---
# Читают apps/electron/src/main/index.ts и scripts/electron-build-main.ts.
# Необязательно; при пустом значении отправка ошибок выключена.
SENTRY_ELECTRON_INGEST_URL=

# --- Ключи агентных моделей ---
# Читает packages/shared/src/agent/backend/internal/drivers/anthropic.ts (необязательно).
ANTHROPIC_API_KEY=
# Читает packages/shared/src/config/storage.ts (сид ключа дефолтного LLM-соединения; необязательно).
ROX_API_KEY=

# --- OAuth-клиенты (необязательно) ---
# Читают scripts/electron-dev.ts (dev-запуск) и scripts/electron-build-main.ts (build-time defines).
# Пользователь может вместо этого задать свои креды через source config в приложении.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=

# --- ROX Drive: импорт из облака (wave 4) ---
# Требуют регистрации приложения у провайдера и владельца OAuth-клиента:
#  - Google Drive: GOOGLE_OAUTH_CLIENT_ID/SECRET (выше) — PKCE-брокер
#    (https://www.googleapis.com/auth/drive.readonly).
#  - OneDrive: ROX_MS_CLIENT_ID — device-code flow.
#  - Яндекс.Диск: ROX_YANDEX_CLIENT_ID/ROX_YANDEX_CLIENT_SECRET — authorization code.
# Назначение импорта (S3-совместимое хранилище; без него drive:import* отвечает
# UNSUPPORTED_OPERATION): ROX_DRIVE_S3_ENDPOINT, ROX_DRIVE_S3_BUCKET,
# ROX_DRIVE_S3_REGION, ROX_DRIVE_S3_ACCESS_KEY_ID, ROX_DRIVE_S3_SECRET_ACCESS_KEY.
ROX_MS_CLIENT_ID=
ROX_YANDEX_CLIENT_ID=
ROX_YANDEX_CLIENT_SECRET=
ROX_DRIVE_S3_ENDPOINT=
ROX_DRIVE_S3_BUCKET=
ROX_DRIVE_S3_REGION=
ROX_DRIVE_S3_ACCESS_KEY_ID=
ROX_DRIVE_S3_SECRET_ACCESS_KEY=

# --- Бэкенд-ключи сервисов: здесь НЕ задаются ---
# DEEPGRAM_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY, BRAVE_API_KEY, E2B_API_KEY,
# TAVILY_API_KEY бэкенд читает из `<config-dir>/service-secrets.env`
# (переопределение: ROX_SERVICE_SECRETS_FILE). См. docs/development/default-service-connections.md.

# --- Dev/build-переключатели (необязательно) ---
# Читают scripts/electron-dev.ts и scripts/electron-build-main.ts.
# CRAFT_DEV_RUNTIME=1 включает dev-режим (подавление автообновления, ручные проверки релиза).
# ROX_WINDOWS_DEV_WITHOUT_OEM=1 собирает Windows без OEM-брендинга.
# ROX_CONFIG_DIR переопределяет каталог конфигурации инстанса.
# CRAFT_DEV_RUNTIME=1
# ROX_WINDOWS_DEV_WITHOUT_OEM=1
# ROX_CONFIG_DIR=

# MICROSOFT_OAUTH_CLIENT_SECRET читается только как esbuild-define на сборке
# (scripts/electron-build-main.ts), в рантайме не используется — PKCE.
# MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Thin-client режим (только для клиентского десктопа) ---
# CRAFT_SERVER_URL указывает на удалённый сервер и включает thin-client режим;
# CRAFT_WORKSPACE_ID выбирает воркспейс (без него показывается выбор).
# CRAFT_SERVER_URL=wss://your-server.example.com
# CRAFT_SERVER_TOKEN=
# CRAFT_WORKSPACE_ID=

# --- Infisical (необязательно) ---
# См. docs/secrets-providers.md.
# INFISICAL_TOKEN=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=
# INFISICAL_BASE_URL=
# INFISICAL_SECRET_PATH=
# INFISICAL_SECRET_KEY=

# --- Продуктовая аналитика: self-hosted PostHog + OpenTelemetry ---
# Product analytics — self-hosted PostHog (capture + feature flags) and
# OpenTelemetry (OTLP/HTTP traces). The live endpoints below are baked into the
# main bundle as defaults at build time; set a variable to override it, or set
# it to an empty value to disable that client (no egress). The renderer receives
# the same values from main. Gated by the «Аналитика продукта» consent toggle
# (default ON). The PostHog project key is a PUBLIC client key, not a secret.
#
# PostHog: base host; capture POSTs to {POSTHOG_HOST}/batch/ and flags to
# {POSTHOG_HOST}/decide/?v=3. POSTHOG_KEY is the public project API key.
POSTHOG_HOST=https://posthog.rox.one
POSTHOG_KEY=phc_sbFWoBoNgqGS82Q6Lone2Hvv2jVy8FMt8dFBLcBBk5X3
# Set POSTHOG_FLAGS_DISABLED=1 to skip /decide entirely (env kill switch).
POSTHOG_FLAGS_DISABLED=
# OpenTelemetry: OTLP/HTTP collector base URL; traces POST to
# {OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces. OTEL_SERVICE_NAME defaults to "rox-desktop".
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.rox.one
OTEL_SERVICE_NAME=rox-desktop

# Telegram account linking (desktop onboarding). The bot daemon runs on the
# platform host; the website proxies /api/link/* to it. ROX_TG_LINK_URL
# defaults to https://rox.one (and to http://127.0.0.1:8095 for a local
# daemon). ROX_TG_LINK_TOKEN must match the website's
# ROX_TG_LINK_PUBLIC_TOKEN (local copy: ~/.config/rox/platform-secrets-20261009.env).
ROX_TG_LINK_URL=
ROX_TG_LINK_TOKEN=
