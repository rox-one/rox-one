# =============================================================================
# ROX Server — multi-platform Docker image
#
# Build:
#   docker buildx build -f Dockerfile.server -t rox-server .
#
# Run (use --user to match host UID/GID for volume permissions):
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/rox \
#     -e ROX_SERVER_TOKEN=<secret> \
#     rox-server
#
# Run with TLS + mounted config:
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/rox \
#     -e ROX_SERVER_TOKEN=<secret> \
#     -e CRAFT_RPC_TLS_CERT=/certs/cert.pem \
#     -e CRAFT_RPC_TLS_KEY=/certs/key.pem \
#     -v /path/to/certs:/certs:ro \
#     -v /path/to/rox-config:/home/rox/.rox \
#     rox-server
# =============================================================================

# Must match `packageManager` in package.json and the `bun-version` pinned in the
# workflows (1.4.2). A 1.3.x bun cannot read a 1.4.x lockfile: it aborts with
# "lockfile had changes, but lockfile is frozen" before installing anything.
# services/rox-maild and services/rox-tg-linkd already pin 1.4.2.
FROM oven/bun:1.4.2-slim@sha256:cb3bbbb08e13a4a2ff400f24c7a2a1d5efa83f6ef8544d52d95a519631e2fc61

LABEL org.opencontainers.image.source="https://github.com/rox-one/rox-one"
LABEL org.opencontainers.image.description="ROX Server — headless AI workflow server"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install system deps + Node.js (required by the WhatsApp worker subprocess;
# Bun cannot run Baileys' crypto deps). Pin Node to a major via NodeSource so
# upgrades are explicit — must match the --target in scripts/build-wa-worker.ts.
ARG NODE_MAJOR=20
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git ripgrep curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user (Claude Code SDK refuses to run as root).
# At runtime, override with --user $(id -u):$(id -g) to match host permissions.
RUN groupadd -r rox && \
    useradd -r -g rox -m -d /home/rox -s /bin/bash rox

WORKDIR /app

# Copy dependency manifests first for layer caching.
# `bunfig.toml` MUST be in the WORKDIR before `bun install` runs — it sets
# `linker = "hoisted"`, which is required for the WebUI / renderer build
# (transitive deps like i18next, @tiptap/*, pdfjs-dist resolve at top-level
# node_modules). Without it Bun defaults to isolated installs and the Vite
# build fails on the first transitive bare-package import.
#
# NOTE: every workspace package manifest (packages/*, apps/*) must be present
# BEFORE `bun install`: the lockfile resolves `workspace:*` dependencies and
# fails with "Workspace dependency ... not found" when a manifest is missing
# (caught live by the server-image pipeline, run 38414093708). When a new
# workspace package appears, extend this list.
COPY package.json bun.lock bunfig.toml ./
COPY packages/server/package.json packages/server/
COPY packages/server-core/package.json packages/server-core/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/session-mcp-server/package.json packages/session-mcp-server/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/ui/package.json packages/ui/
COPY packages/messaging-gateway/package.json packages/messaging-gateway/
COPY packages/messaging-whatsapp-worker/package.json packages/messaging-whatsapp-worker/
COPY packages/messaging-discord-worker/package.json packages/messaging-discord-worker/
COPY packages/cloud-runner/package.json packages/cloud-runner/
COPY packages/browser-intel/package.json packages/browser-intel/
# The canvas workspaces arrived with the canvas PRs; their manifests must be in
# this layer too, or the frozen install fails on the workspace set
# ("@rox/electron depends on workspace @rox/canvas-core … but not on disk").
COPY packages/canvas-core/package.json packages/canvas-core/
COPY packages/canvas-relay/package.json packages/canvas-relay/
COPY packages/rovers-core-lite/package.json packages/rovers-core-lite/
# `packages/rovers-core` is a workspace listed in bun.lock; the manifest layer must
# cover every workspace or the frozen install sees an incomplete workspace set.
COPY packages/rovers-core/package.json packages/rovers-core/
COPY packages/test-harness/package.json packages/test-harness/
# Canvas packages are workspaces listed in bun.lock too. They were added after this
# list was written, and the frozen install failed with "workspace ... is listed in
# bun.lock but not on disk" until they were named here.
COPY packages/canvas-core/package.json packages/canvas-core/
COPY packages/canvas-relay/package.json packages/canvas-relay/
COPY apps/electron/package.json apps/electron/
COPY apps/cli/package.json apps/cli/
COPY apps/viewer/package.json apps/viewer/
COPY apps/webui/package.json apps/webui/
COPY apps/cloud-gateway/package.json apps/cloud-gateway/
COPY apps/workspace-service/package.json apps/workspace-service/

# The repo postinstall (package.json) invokes this script, so it must exist before
# install. This image is headless and never needs the Electron runtime.
COPY scripts/ensure-electron-binary.mjs scripts/
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

RUN bun install --frozen-lockfile

# Copy source
COPY . .

# Keep the compatibility Pi helper on its canonical Bun/ESM package recipe.
# No registered driver consumes the old session-mcp-server CJS bundle.
RUN bun run server:build:subprocess

# Build the WhatsApp + Discord worker bundles (CJS, Node target — Bun cannot run them).
RUN bun run scripts/build-wa-worker.ts && bun run scripts/build-discord-worker.ts

# Build web UI assets (served by the server on the RPC port).
# vite's bundler runs under Node (via shebang in vite's bin) and hits V8's
# default ~2GB heap cap on the rendering phase (>5k modules). Raise to 4GB
# so low-RAM build hosts (e.g. 4GB VPS) can complete the build.
RUN NODE_OPTIONS="--max-old-space-size=4096" bunx vite build --config apps/webui/vite.config.ts

# Pre-create .rox so Docker named volumes inherit the correct permissions.
RUN mkdir -p /home/rox/.rox

# Make app world-readable so any --user can run it. Home dir is writable for .rox.
# Use find to only touch files/dirs missing the read bit — much faster than chmod -R on the
# entire tree (node_modules alone has hundreds of thousands of entries).
RUN find /app -not -perm -o=r -exec chmod o+r {} + && \
    find /app -type d -not -perm -o=x -exec chmod o+x {} + && \
    chmod -R 777 /home/rox

USER rox

ENV CRAFT_RPC_HOST=0.0.0.0
ENV CRAFT_RPC_PORT=9100
ENV CRAFT_WEBUI_DIR=/app/apps/webui/dist
ENV CRAFT_BUNDLED_ASSETS_ROOT=/app/apps/electron
# WhatsApp worker — Bun cannot run the CJS worker, so we point the adapter at
# system `node` (installed above). If CRAFT_BUNDLED_ASSETS_ROOT changes, update
# CRAFT_MESSAGING_WA_WORKER to match; the default in packages/server resolves
# against CRAFT_BUNDLED_ASSETS_ROOT, but the layout above flattens to /app.
ENV CRAFT_MESSAGING_WA_WORKER=/app/packages/messaging-whatsapp-worker/dist/worker.cjs
ENV CRAFT_MESSAGING_DISCORD_WORKER=/app/packages/messaging-discord-worker/dist/worker.cjs
ENV CRAFT_MESSAGING_NODE_BIN=node

EXPOSE 9100

ENTRYPOINT ["bun", "run", "packages/server/src/index.ts"]