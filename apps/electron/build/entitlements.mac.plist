<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- App-only entitlements (main executable, Contents/MacOS/Rox).
         JIT / unsigned-executable-memory are deliberately NOT here: they are
         restricted to the runtime binaries via build/entitlements.runtime.plist
         (see electron-builder.yml `entitlementsInherit`). -->
    <!-- https://github.com/electron-userland/electron-builder/issues/3940 -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Hardened runtime: microphone for meeting recording / dictation -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>