{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rox.one/schemas/macro-integration/coding-executor-run-v1.json",
  "title": "Prepared coding executor RunSpec v1",
  "description": "Preparation contract only; executor adapter and scheduler dispatch are proposed. Schema shape does not prove lease/permission/ancestry/proof validity.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "rox.coding-executor/v1"
    },
    "preparationState": {
      "const": "PREPARED_NOT_LAUNCHED"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1
    },
    "wpId": {
      "enum": [
        "WP-01",
        "WP-02",
        "WP-03",
        "WP-04",
        "WP-05",
        "WP-06",
        "WP-07",
        "WP-08",
        "WP-09",
        "WP-10",
        "WP-11",
        "WP-12",
        "WP-13",
        "WP-14",
        "WP-15",
        "WP-16",
        "WP-17",
        "WP-18",
        "WP-19",
        "WP-20",
        "WP-21",
        "WP-22",
        "WP-23",
        "WP-24",
        "WP-25",
        "WP-26",
        "WP-27",
        "WP-28",
        "WP-29",
        "WP-30",
        "WP-31",
        "WP-32",
        "WP-33",
        "WP-34",
        "WP-35",
        "WP-36",
        "WP-37",
        "WP-38",
        "WP-39",
        "WP-40",
        "WP-41",
        "WP-42",
        "WP-43",
        "WP-44",
        "WP-45",
        "WP-46",
        "WP-47",
        "WP-48",
        "WP-49",
        "WP-50",
        "WP-51",
        "WP-52"
      ]
    },
    "executionMode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "selectedLane": {
      "$ref": "#/definitions/lane"
    },
    "inputAuthority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "rox-one/rox-one"
        },
        "remoteUrl": {
          "const": "https://github.com/rox-one/rox-one.git"
        },
        "inputSha": {
          "$ref": "#/definitions/gitSha"
        },
        "studySha": {
          "$ref": "#/definitions/gitSha"
        },
        "specDigest": {
          "$ref": "#/definitions/hash"
        },
        "manifestPath": {
          "$ref": "#/definitions/relativePath"
        },
        "manifestSha256": {
          "$ref": "#/definitions/hash"
        },
        "packetPath": {
          "$ref": "#/definitions/relativePath"
        },
        "packetSha256": {
          "$ref": "#/definitions/hash"
        },
        "promptPath": {
          "$ref": "#/definitions/relativePath"
        },
        "promptSha256": {
          "$ref": "#/definitions/hash"
        },
        "executorSchemaSha256": {
          "$ref": "#/definitions/hash"
        }
      },
      "required": [
        "repository",
        "remoteUrl",
        "inputSha",
        "studySha",
        "specDigest",
        "manifestPath",
        "manifestSha256",
        "packetPath",
        "packetSha256",
        "promptPath",
        "promptSha256",
        "executorSchemaSha256"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "wpId": {
            "enum": [
              "WP-01",
              "WP-02",
              "WP-03",
              "WP-04",
              "WP-05",
              "WP-06",
              "WP-07",
              "WP-08",
              "WP-09",
              "WP-10",
              "WP-11",
              "WP-12",
              "WP-13",
              "WP-14",
              "WP-15",
              "WP-16",
              "WP-17",
              "WP-18",
              "WP-19",
              "WP-20",
              "WP-21",
              "WP-22",
              "WP-23",
              "WP-24",
              "WP-25",
              "WP-26",
              "WP-27",
              "WP-28",
              "WP-29",
              "WP-30",
              "WP-31",
              "WP-32",
              "WP-33",
              "WP-34",
              "WP-35",
              "WP-36",
              "WP-37",
              "WP-38",
              "WP-39",
              "WP-40",
              "WP-41",
              "WP-42",
              "WP-43",
              "WP-44",
              "WP-45",
              "WP-46",
              "WP-47",
              "WP-48",
              "WP-49",
              "WP-50",
              "WP-51",
              "WP-52"
            ]
          },
          "receiptPath": {
            "$ref": "#/definitions/relativePath"
          },
          "receiptSha256": {
            "$ref": "#/definitions/hash"
          },
          "commitSha": {
            "$ref": "#/definitions/gitSha"
          },
          "inputSha": {
            "$ref": "#/definitions/gitSha"
          },
          "specDigest": {
            "$ref": "#/definitions/hash"
          },
          "reviewerRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "wpId",
          "receiptPath",
          "receiptSha256",
          "commitSha",
          "inputSha",
          "specDigest",
          "reviewerRef"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "issuerRef": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "prepared"
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 1
        },
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "ownedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relativePath"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "proofPrefix": {
          "$ref": "#/definitions/relativePath"
        },
        "receiptPath": {
          "$ref": "#/definitions/relativePath"
        }
      },
      "required": [
        "leaseId",
        "issuerRef",
        "state",
        "fencingToken",
        "notBefore",
        "expiresAt",
        "ownedPaths",
        "proofPrefix",
        "receiptPath"
      ]
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "fresh_isolated_checkout"
        },
        "branch": {
          "type": "string",
          "pattern": "^impl/macro-wp-[0-9]{2}-[a-z0-9][a-z0-9-]{0,48}$"
        },
        "hooks": {
          "const": "disabled"
        },
        "submodules": {
          "const": "disabled_unless_pinned_allowlisted"
        },
        "lfs": {
          "const": "disabled_unless_pinned_allowlisted"
        },
        "userConfig": {
          "const": "isolated_git_config"
        },
        "integrationPolicy": {
          "const": "merge_default_no_force_push"
        },
        "writeDefaultBranch": {
          "const": false
        },
        "pushPolicy": {
          "enum": [
            "none",
            "assigned_draft_branch_only"
          ]
        },
        "draftPrPolicy": {
          "enum": [
            "none",
            "assigned_repository_draft_only"
          ]
        }
      },
      "required": [
        "strategy",
        "branch",
        "hooks",
        "submodules",
        "lfs",
        "userConfig",
        "integrationPolicy",
        "writeDefaultBranch",
        "pushPolicy",
        "draftPrPolicy"
      ]
    },
    "lanePlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linux-domain": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "requiredMode": {
              "enum": [
                "fixture_allowed",
                "live_only"
              ]
            },
            "runnerProfileRef": {
              "type": "string",
              "minLength": 1
            },
            "proofContract": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "required",
            "requiredMode",
            "runnerProfileRef",
            "proofContract"
          ]
        },
        "linux-renderer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "requiredMode": {
              "enum": [
                "fixture_allowed",
                "live_only"
              ]
            },
            "runnerProfileRef": {
              "type": "string",
              "minLength": 1
            },
            "proofContract": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "required",
            "requiredMode",
            "runnerProfileRef",
            "proofContract"
          ]
        },
        "macos-native": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "requiredMode": {
              "const": "live_only"
            },
            "runnerProfileRef": {
              "type": "string",
              "minLength": 1
            },
            "proofContract": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "required",
            "requiredMode",
            "runnerProfileRef",
            "proofContract"
          ]
        },
        "provider-live": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "requiredMode": {
              "const": "live_only"
            },
            "runnerProfileRef": {
              "type": "string",
              "minLength": 1
            },
            "proofContract": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "required",
            "requiredMode",
            "runnerProfileRef",
            "proofContract"
          ]
        }
      },
      "required": [
        "linux-domain",
        "linux-renderer",
        "macos-native",
        "provider-live"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "enum": [
            "linux",
            "darwin"
          ]
        },
        "imageRef": {
          "type": "string",
          "minLength": 1
        },
        "imageDigest": {
          "$ref": "#/definitions/hash"
        },
        "bunVersion": {
          "const": "1.3.14"
        },
        "nodeMajor": {
          "const": 22
        },
        "installPolicy": {
          "const": "frozen_lockfile"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diskGiB": {
              "type": "integer",
              "minimum": 8
            },
            "ramGiB": {
              "type": "integer",
              "minimum": 8
            },
            "cpus": {
              "type": "integer",
              "minimum": 4
            }
          },
          "required": [
            "diskGiB",
            "ramGiB",
            "cpus"
          ]
        }
      },
      "required": [
        "os",
        "imageRef",
        "imageDigest",
        "bunVersion",
        "nodeMajor",
        "installPolicy",
        "resources"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWallClockSec": {
          "type": "integer",
          "minimum": 60
        },
        "heartbeatIntervalSec": {
          "type": "integer",
          "minimum": 5
        },
        "heartbeatDeadlineSec": {
          "type": "integer",
          "minimum": 15
        },
        "maxLlmTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxArtifactsBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxCostMinor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "maxResumeAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "retentionSec": {
          "type": "integer",
          "minimum": 3600
        },
        "cancelGraceSec": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxWallClockSec",
        "heartbeatIntervalSec",
        "heartbeatDeadlineSec",
        "maxLlmTokens",
        "maxArtifactsBytes",
        "maxCostMinor",
        "currency",
        "maxResumeAttempts",
        "retentionSec",
        "cancelGraceSec"
      ]
    },
    "credentialRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^credential://[a-zA-Z0-9._/-]+$"
          },
          "purpose": {
            "enum": [
              "git_read",
              "git_draft_write",
              "model_gateway",
              "test_provider",
              "test_database",
              "object_store"
            ]
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "injection": {
            "enum": [
              "brokered_socket",
              "memory_fd",
              "temporary_environment"
            ]
          }
        },
        "required": [
          "ref",
          "purpose",
          "audience",
          "scopes",
          "expiresAt",
          "injection"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultPolicy": {
          "const": "deny"
        },
        "allowHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "providerTenantRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "productionAccess": {
          "const": false
        }
      },
      "required": [
        "defaultPolicy",
        "allowHosts",
        "providerTenantRefs",
        "productionAccess"
      ]
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commitRequired": {
          "type": "boolean"
        },
        "patchPath": {
          "$ref": "#/definitions/relativePath"
        },
        "runOutcomePath": {
          "$ref": "#/definitions/relativePath"
        },
        "eventsPath": {
          "$ref": "#/definitions/relativePath"
        },
        "checkpointPath": {
          "$ref": "#/definitions/relativePath"
        },
        "receiptSchemaPath": {
          "const": "cloud/macro-integration/completion.schema.json"
        },
        "completionReceiptPath": {
          "$ref": "#/definitions/relativePath"
        },
        "proofPrefix": {
          "$ref": "#/definitions/relativePath"
        },
        "independentReviewRequired": {
          "const": true
        },
        "automaticMerge": {
          "const": false
        },
        "automaticDeploy": {
          "const": false
        },
        "laneReceiptFragmentPath": {
          "$ref": "#/definitions/relativePath"
        },
        "canonicalReceiptWriter": {
          "const": "coordinator_only"
        }
      },
      "required": [
        "commitRequired",
        "patchPath",
        "runOutcomePath",
        "eventsPath",
        "checkpointPath",
        "receiptSchemaPath",
        "completionReceiptPath",
        "proofPrefix",
        "independentReviewRequired",
        "automaticMerge",
        "automaticDeploy",
        "laneReceiptFragmentPath",
        "canonicalReceiptWriter"
      ]
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "reconcile_then_resume_same_input_only"
        },
        "checkpointRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpointSha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "priorAttemptId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "policy",
        "checkpointRef",
        "checkpointSha256",
        "priorAttemptId"
      ]
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "const": "transport_authenticated_scheduler_separate_envelope"
        },
        "executionEnabled": {
          "const": false
        }
      },
      "required": [
        "authorization",
        "executionEnabled"
      ]
    },
    "jobRole": {
      "enum": [
        "implementation",
        "verification"
      ]
    },
    "verificationOf": {
      "anyOf": [
        {
          "$ref": "#/definitions/VerificationOf"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "apiVersion",
    "preparationState",
    "runId",
    "idempotencyKey",
    "attemptNumber",
    "wpId",
    "executionMode",
    "selectedLane",
    "inputAuthority",
    "prerequisites",
    "lease",
    "checkout",
    "lanePlan",
    "environment",
    "limits",
    "credentialRefs",
    "network",
    "deliverables",
    "resume",
    "dispatch",
    "jobRole",
    "verificationOf"
  ],
  "definitions": {
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\x00-\\x1f])[^\\\\]+$"
    },
    "lane": {
      "enum": [
        "linux-domain",
        "linux-renderer",
        "macos-native",
        "provider-live"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "sha256": {
          "$ref": "#/definitions/hash"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "mediaType"
      ]
    },
    "failureClass": {
      "enum": [
        "input_stale",
        "spec_stale",
        "lease_denied",
        "permission_denied",
        "credential_missing",
        "resource_unavailable",
        "environment_failure",
        "baseline_failure",
        "assertion_failure",
        "provider_failure",
        "timeout",
        "cancelled",
        "evidence_invalid",
        "unknown_status"
      ]
    },
    "RunOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "rox.coding-executor/outcome-v1"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "attemptNumber": {
          "type": "integer",
          "minimum": 1
        },
        "requestSha256": {
          "$ref": "#/definitions/hash"
        },
        "wpId": {
          "enum": [
            "WP-01",
            "WP-02",
            "WP-03",
            "WP-04",
            "WP-05",
            "WP-06",
            "WP-07",
            "WP-08",
            "WP-09",
            "WP-10",
            "WP-11",
            "WP-12",
            "WP-13",
            "WP-14",
            "WP-15",
            "WP-16",
            "WP-17",
            "WP-18",
            "WP-19",
            "WP-20",
            "WP-21",
            "WP-22",
            "WP-23",
            "WP-24",
            "WP-25",
            "WP-26",
            "WP-27",
            "WP-28",
            "WP-29",
            "WP-30",
            "WP-31",
            "WP-32",
            "WP-33",
            "WP-34",
            "WP-35",
            "WP-36",
            "WP-37",
            "WP-38",
            "WP-39",
            "WP-40",
            "WP-41",
            "WP-42",
            "WP-43",
            "WP-44",
            "WP-45",
            "WP-46",
            "WP-47",
            "WP-48",
            "WP-49",
            "WP-50",
            "WP-51",
            "WP-52"
          ]
        },
        "selectedLane": {
          "$ref": "#/definitions/lane"
        },
        "inputSha": {
          "$ref": "#/definitions/gitSha"
        },
        "specDigest": {
          "$ref": "#/definitions/hash"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 1
        },
        "terminalState": {
          "enum": [
            "artifact_ready",
            "failed",
            "cancelled",
            "timed_out",
            "blocked",
            "lost"
          ]
        },
        "failureClass": {
          "anyOf": [
            {
              "$ref": "#/definitions/failureClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "commitSha": {
          "anyOf": [
            {
              "$ref": "#/definitions/gitSha"
            },
            {
              "type": "null"
            }
          ]
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relativePath"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/artifact"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "completionReceiptPath": {
          "$ref": "#/definitions/relativePath"
        },
        "productCompletion": {
          "const": "pending_independent_verification"
        },
        "providerCleanup": {
          "enum": [
            "confirmed",
