+const OPENROUTER_ALIAS = "openrouter";
+const OPENROUTER_OWNER_FIELDS = ["owned_by", "provider", "providerId", "provider_id"] as const;
+const OPENROUTER_PATH_FIELDS = ["id", "root", "parent"] as const;
+
+function normalizeCatalogField(value: unknown): string | null {
+  return typeof value === "string" ? value.trim().toLowerCase() : null;
+}
+
+/**
+ * Recognize every representation of an OpenRouter model the catalog can emit:
+ * canonical live entries (`openrouter/<vendor>/<model>`, `owned_by: "openrouter"`),
+ * provider-scoped paths that nest the alias deeper, and the legacy The Old LLM
+ * free-tier ids (`openrouter_gpt_4_o`). Ownership is compared exactly and paths are
+ * matched per segment so a model that merely mentions the word is not swept up.
+ */
 export function isOpenRouterCatalogEntry(entry: Record<string, unknown>): boolean {
-  return [entry.id, entry.root, entry.parent]
-    .filter((value): value is string => typeof value === "string")
-    .some((value) => value.toLowerCase().includes("openrouter_"));
+  const ownedByOpenRouter = OPENROUTER_OWNER_FIELDS.some(
+    (field) => normalizeCatalogField(entry[field]) === OPENROUTER_ALIAS
+  );
+  if (ownedByOpenRouter) return true;
+
+  return OPENROUTER_PATH_FIELDS.some((field) => {
+    const value = normalizeCatalogField(entry[field]);
+    if (!value) return false;
+    return value.includes("openrouter_") || value.split("/").includes(OPENROUTER_ALIAS);
+  });
+}
+
+/**
+ * Restrict a ROX public catalog to what a DB-backed key may use. Entries that are
+ * not canonical `rox/*` ids are dropped outright: public mode publishes the public
+ * surface and nothing else, whichever branch assembled the list.
+ */
+export async function scopeRoxPublicCatalogForKey(
+  catalog: Array<Record<string, unknown>>,
+  apiKey: string,
+  isModelAllowedForKey: (key: string, modelId: string) => Promise<boolean>
+): Promise<Array<Record<string, unknown>>> {
+  const scoped: Array<Record<string, unknown>> = [];
+  for (const entry of catalog) {
+    if (!isRoxPublicModelId(entry.id)) continue;
+    if (!(await isModelAllowedForKey(apiKey, entry.id))) continue;
+    scoped.push(entry);
+  }
+  return scoped;
 }
 
