+/**
+ * tests/unit/rox-openrouter-catalog-exclusion.test.ts
+ *
+ * ROX contract: OpenRouter is not part of the published model list, and the ROX
+ * public catalog publishes nothing but `rox/*`. Both are end-to-end properties of
+ * `GET /v1/models`, so they are asserted against the real response body rather
+ * than against the policy helper — a predicate that fails to recognize an entry
+ * is exactly the failure mode this file exists to catch.
+ *
+ * The three request shapes below are the ones that reach `finalizeCatalogResponse`
+ * through different branches: the global filter (no key), the per-key allow-list
+ * (DB-backed key), and the quota-exclusive short circuit, which returns before the
+ * catalog is ever built.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-rox-openrouter-"));
+const ORIGINAL_ROX_PUBLIC_CATALOG_ONLY = process.env.ROX_PUBLIC_CATALOG_ONLY;
+
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "rox-openrouter-exclusion-secret";
+
+const core = await import("../../src/lib/db/core.ts");
+const apiKeysDb = await import("../../src/lib/db/apiKeys.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const poolsDb = await import("../../src/lib/db/quotaPools.ts");
+const groupsDb = await import("../../src/lib/db/quotaGroups.ts");
+const { syncQuotaCombos } = await import("../../src/lib/quota/quotaCombos.ts");
+const { isOpenRouterCatalogEntry, isRoxPublicModelId } =
+  await import("../../src/lib/roxPublicModelPolicy.ts");
+const v1ModelsCatalog = await import("../../src/app/api/v1/models/catalog.ts");
+
+const OPENROUTER_MODEL_ID = "google/gemini-2.5-flash";
+const QUALIFIED_OPENROUTER_ID = `openrouter/${OPENROUTER_MODEL_ID}`;
+
+interface CatalogEntry extends Record<string, unknown> {
+  id: string;
+}
+
+const originalFetch = globalThis.fetch;
+
+/** Serve a canonical OpenRouter catalog payload without touching the network. */
+function installOpenRouterCatalogStub(): void {
+  globalThis.fetch = (async (input: unknown, init?: unknown) => {
+    const url = typeof input === "string" ? input : String((input as { url?: string })?.url ?? "");
+    if (url.includes("openrouter.ai")) {
+      return new Response(
+        JSON.stringify({
+          data: [
+            {
+              id: OPENROUTER_MODEL_ID,
+              name: "Gemini 2.5 Flash",
+              context_length: 1_048_576,
+              architecture: { input_modalities: ["text"], output_modalities: ["text"] },
+              supported_parameters: ["tools"],
+              top_provider: { max_completion_tokens: 65_536 },
+            },
+          ],
+        }),
+        { status: 200, headers: { "content-type": "application/json" } }
+      );
+    }
+    return originalFetch(input as never, init as never);
+  }) as typeof globalThis.fetch;
+}
+
+/**
+ * Detect OpenRouter entries from the response shape alone. Deliberately does not
+ * call `isOpenRouterCatalogEntry` — the production predicate is one of the things
+ * under test.
+ */
+function findOpenRouterEntries(models: CatalogEntry[]): CatalogEntry[] {
+  return models.filter((model) => {
+    const ownedBy = String(model.owned_by ?? "")
+      .trim()
+      .toLowerCase();
+    if (ownedBy === "openrouter") return true;
+    return [model.id, model.root, model.parent].some((value) => {
+      if (typeof value !== "string") return false;
+      const normalized = value.trim().toLowerCase();
+      return normalized.includes("openrouter_") || normalized.split("/").includes("openrouter");
+    });
+  });
+}
+
+async function readCatalog(apiKey?: string): Promise<CatalogEntry[]> {
+  v1ModelsCatalog.__expireCatalogCacheForTest(
+    v1ModelsCatalog.CATALOG_STALE_WHILE_REVALIDATE_MS + 1000
+  );
+  v1ModelsCatalog.__resetCatalogBuilderRunsForTest();
+  const response = await v1ModelsCatalog.getUnifiedModelsResponse(
+    new Request(
+      "http://localhost/api/v1/models",
+      apiKey ? { headers: { Authorization: `Bearer ${apiKey}` } } : undefined
+    )
+  );
+  assert.equal(response.status, 200);
+  const body = (await response.json()) as { data: CatalogEntry[] };
+  return body.data;
+}
+
+test.before(async () => {
+  installOpenRouterCatalogStub();
+  await providersDb.createProviderConnection({
+    provider: "openrouter",
+    authType: "apikey",
+    name: "rox-exclusion-openrouter",
+    apiKey: "sk-or-rox-exclusion",
+    isActive: true,
+    testStatus: "active",
+  });
+});
+
+test.beforeEach(() => {
+  delete process.env.ROX_PUBLIC_CATALOG_ONLY;
+});
+
+test.after(() => {
+  globalThis.fetch = originalFetch;
+  apiKeysDb.resetApiKeyState();
+  core.resetDbInstance();
+  if (ORIGINAL_ROX_PUBLIC_CATALOG_ONLY === undefined) {
+    delete process.env.ROX_PUBLIC_CATALOG_ONLY;
+  } else {
+    process.env.ROX_PUBLIC_CATALOG_ONLY = ORIGINAL_ROX_PUBLIC_CATALOG_ONLY;
+  }
+  try {
+    fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  } catch {
+    /* ignore */
+  }
+});
+
+test("the OpenRouter catalog entry this suite relies on is actually produced", async () => {
+  // Guards every assertion below: if the connection stops yielding an OpenRouter
+  // entry, the exclusion tests would pass without proving anything.
+  const { getOpenRouterCatalog } = await import("../../src/lib/catalog/openrouterCatalog.ts");
+  const catalog = await getOpenRouterCatalog();
+  assert.deepEqual(
+    catalog.data.map((entry) => entry.id),
+    [OPENROUTER_MODEL_ID]
+  );
+});
+
+test("the policy predicate recognizes the catalog's canonical OpenRouter shape", () => {
+  // The exact record `buildUnifiedModelsResponseCore` pushes for a live entry.
+  assert.equal(
+    isOpenRouterCatalogEntry({
+      id: QUALIFIED_OPENROUTER_ID,
+      owned_by: "openrouter",
+      root: OPENROUTER_MODEL_ID,
+      parent: null,
+    }),
+    true
+  );
+});
+
+test("normal catalog mode drops OpenRouter for an unauthenticated caller", async () => {
+  const models = await readCatalog();
+
+  assert.ok(models.length > 0, "the catalog must not be empty, or the test proves nothing");
+  assert.deepEqual(
+    findOpenRouterEntries(models).map((model) => model.id),
+    []
+  );
+});
+
+test("a DB-backed key permitted to use an OpenRouter model still cannot see it", async () => {
+  const key = await apiKeysDb.createApiKey("rox-openrouter-scoped", "rox-openrouter-machine");
+  await apiKeysDb.updateApiKeyPermissions(key.id, {
