services:
  db:
    image: {{ windmill_postgres_image }}
    restart: unless-stopped
    shm_size: 512m
    environment:
      POSTGRES_PASSWORD: ${WINDMILL_DB_PASSWORD}
      POSTGRES_DB: windmill
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 10

  windmill-server:
    image: {{ windmill_image }}
    restart: unless-stopped
    environment:
      DATABASE_URL: ${WINDMILL_DATABASE_URL}
      MODE: server
      SUPERADMIN_SECRET: ${WINDMILL_SUPERADMIN_SECRET}
      BASE_URL: http://{{ windmill_tailnet_ip }}:{{ windmill_port }}
    ports:
      - "{{ windmill_tailnet_ip }}:{{ windmill_port }}:8000"
    depends_on:
      db:
        condition: service_healthy

  worker-small:
    image: {{ windmill_image }}
    restart: unless-stopped
    environment:
      DATABASE_URL: ${WINDMILL_DATABASE_URL}
      MODE: worker
      WORKER_GROUP: linux-small
      NUM_WORKERS: "1"
    volumes:
      - worker_cache:/tmp/windmill/cache
      - worker_logs:/tmp/windmill/logs
    depends_on:
      db:
        condition: service_healthy

  worker-ops:
    image: {{ windmill_image }}
    restart: unless-stopped
    environment:
      DATABASE_URL: ${WINDMILL_DATABASE_URL}
      MODE: worker
      WORKER_GROUP: privileged-ops
      NUM_WORKERS: "1"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - worker_cache:/tmp/windmill/cache
      - worker_logs:/tmp/windmill/logs
    depends_on:
      db:
        condition: service_healthy

  worker-backup:
    image: {{ windmill_image }}
    restart: unless-stopped
    environment:
      DATABASE_URL: ${WINDMILL_DATABASE_URL}
      MODE: worker
      WORKER_GROUP: backup
      NUM_WORKERS: "1"
    volumes:
      - worker_logs:/tmp/windmill/logs
    depends_on:
      db:
        condition: service_healthy

volumes:
  db_data:
  worker_cache:
  worker_logs:
