[Unit]
Description=ROX Windmill control plane
After=docker.service infisical-agent.service tailscaled.service
Requires=docker.service infisical-agent.service

[Service]
Type=simple
WorkingDirectory={{ windmill_install_dir }}
ExecStart=/usr/local/sbin/windmill-compose up --remove-orphans
ExecStop=/usr/local/sbin/windmill-compose down --timeout 30
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

