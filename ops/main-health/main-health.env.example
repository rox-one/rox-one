# Образец файла окружения для ops/main-health/main-health.sh.
#
# Установка:
#   mkdir -p ~/.config/rox
#   cp ops/main-health/main-health.env.example ~/.config/rox/main-health.env
#   chmod 600 ~/.config/rox/main-health.env
#   # затем впишите реальные значения (файл НЕ коммитится).
#
# Telegram-бот: создайте бота у @BotFather, получите токен.
# chat_id: id личного чата/группы (например, через @userinfobot).
MAIN_HEALTH_TG_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
MAIN_HEALTH_TG_CHAT_ID=REPLACE_WITH_CHAT_ID
