{
  "name": "@rox/server-core",
  "version": "0.11.8",
  "license": "Apache-2.0",
  "description": "Reusable headless server infrastructure for Craft Agent",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./command-gateway": "./src/command-gateway/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./model-fetchers": "./src/model-fetchers/index.ts",
    "./domain": "./src/domain/index.ts",
    "./services": "./src/services/index.ts",
    "./handlers/rpc": "./src/handlers/rpc/index.ts",
    "./handlers/rpc/*": "./src/handlers/rpc/*.ts",
    "./sessions": "./src/sessions/index.ts",
    "./tasks": "./src/tasks/index.ts",
    "./knowledge": "./src/knowledge/index.ts",
    "./openclaw": "./src/openclaw/index.ts",
    "./workgraph": "./src/workgraph/index.ts",
    "./observability": "./src/observability/index.ts",
    "./meetings": "./src/meetings/index.ts",
    "./docs/*": "./src/docs/*.ts",
    "./memory/learning/*": "./src/memory/learning/*.ts",
    "./workspace-work/*": "./src/workspace-work/*.ts"
  },
  "scripts": {},
  "dependencies": {
    "@rox/cloud-runner": "workspace:*",
    "@rox/core": "workspace:*",
    "@rox/session-tools-core": "workspace:*",
    "@rox/shared": "workspace:*",
    "@earendil-works/pi-ai": "0.85.1",
    "@tursodatabase/database": "0.7.2",
    "@xenova/transformers": "2.17.2",
    "gray-matter": "^4.0.3",
    "jose": "^6.0.0",
    "js-yaml": "^4.1.1",
    "sharp": "0.35.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
