      "settings": {
        "foreground": "#d89079"
      },
      "name": "Zed capture: function.decorator"
    },
    {
      "scope": [
        "variable.parameter.function.keyword"
      ],
      "settings": {
        "foreground": "#88c0d0"
      },
      "name": "Zed capture: function.kwargs"
