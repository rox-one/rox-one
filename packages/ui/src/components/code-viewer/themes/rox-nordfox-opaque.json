{
  "name": "rox-nordfox-opaque",
  "displayName": "Nordfox - opaque",
  "type": "dark",
  "colors": {
    "editor.background": "#2e3440",
    "editor.foreground": "#cdcecf",
    "editor.selectionBackground": "#5d4b4d"
  },
  "settings": [
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#81a1c1",
        "fontStyle": "italic"
      },
      "name": "Zed capture: attribute"
    },
    {
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#d89079",
        "fontStyle": ""
      },
      "name": "Zed capture: attribute.builtin"
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#d89079"
      },
      "name": "Zed capture: boolean"
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#909dad"
      },
      "name": "Zed capture: comment"
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#909dad"
      },
      "name": "Zed capture: comment.doc"
    },
    {
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#d89079"
      },
      "name": "Zed capture: constant"
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#d89079"
      },
      "name": "Zed capture: constant.builtin"
    },
    {
      "scope": [
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#88c0d0"
      },
      "name": "Zed capture: constructor"
    },
    {
      "scope": [
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#cdcecf"
      },
      "name": "Zed capture: embedded"
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#cf888f",
        "fontStyle": "italic"
      },
      "name": "Zed capture: emphasis"
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#cf888f",
        "fontStyle": "bold"
      },
      "name": "Zed capture: emphasis.strong"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8cafd2"
      },
      "name": "Zed capture: function"
    },
    {
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#cf888f"
      },
      "name": "Zed capture: function.builtin"
    },
    {
      "scope": [
        "entity.name.function.decorator",
