    {
      "scope": [
        "markup.underline.link.url",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#d89079",
        "fontStyle": "italic"
      },
      "name": "Zed capture: link_uri"
    },
    {
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#93ccdc"
      },
      "name": "Zed capture: namespace"
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#cd8c76"
      },
      "name": "Zed capture: number"
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#abb1bb"
      },
