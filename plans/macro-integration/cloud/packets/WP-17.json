      {
        "artifact": "apps/workspace-service/migrations/17-domain-contract.sql",
        "status": "proposed migration identifier; actual filename generated by selected migrator, no fabricated timestamp",
        "tables": [
          "mail_account",
          "mail_thread",
          "mail_message",
          "mail_label",
          "provider_connection"
        ],
        "commonColumns": {
          "workspace_id": "uuid NOT NULL except globally auth principals",
          "entity_id": "text canonical kind:id for entity-owned tables",
          "schema_version": "integer NOT NULL CHECK >0",
          "revision": "bigint NOT NULL CHECK >=0",
          "created_at": "timestamptz",
          "updated_at": "timestamptz",
          "deleted_at": "timestamptz NULL for retained entities"
        },
        "constraints": [
          {
            "name": "entity_identity",
            "definition": "Entity-owned row composite FK (workspace_id,entity_id) -> entity; principal/receipt/job tables own typed key"
          },
          {
            "name": "idempotency",
            "definition": "UNIQUE(workspace_id, actor_principal_id, idempotency_key) for command_receipt; request_hash checked on conflict"
          },
          {
            "name": "alias_identity",
            "definition": "UNIQUE(workspace_id,provider,account,remote_type,remote_id) in alias tables"
          },
          {
            "name": "event_delivery",
            "definition": "UNIQUE(consumer_id,event_id); claimed lease separate processed; aggregate_revision+policy/tombstone fence enforced"
          }
        ],
        "domainConstraints": [
          "UNIQUE(workspace_id,provider,provider_account_id); account owner/connection grants separate from entity sharing.",
          "UNIQUE(account_id,remote_entity_type,remote_id) aliases; Message-ID nonunique across mailbox copies.",
          "Body blobs and attachments inherit source-mail read policy; token reference only, no OAuth secret in entity/event/search document."
        ],
        "indexes": [
          "workspace + entity primary lookup",
          "domain filter + stable cursor sort",
          "event pending lease/status/time",
