          "deleted_at": "timestamptz NULL for retained entities"
        },
        "constraints": [
          {
            "name": "entity_identity",
            "definition": "Entity-owned row composite FK (workspace_id,entity_id) -> entity; principal/receipt/job tables own typed key"
          },
          {
            "name": "idempotency",
            "definition": "UNIQUE(workspace_id, actor_principal_id, idempotency_key) for command_receipt; request_hash checked on conflict"
          },
          {
            "name": "alias_identity",
            "definition": "UNIQUE(workspace_id,provider,account,remote_type,remote_id) in alias tables"
          },
