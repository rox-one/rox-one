{
  ".github/workflows/pocket-native-vault.yml": {
    "triggers": [
      "workflow_dispatch"
    ],
    "permissions": {
      "contents": "read"
    },
    "timeoutMinutes": 15
  },
  ".github/workflows/desktop-release.yml": {
    "triggers": [
      "push",
      "workflow_dispatch"
    ],
    "permissions": {
      "contents": "read"
    },
    "timeoutMinutes": 60
  }
}
