{
  "$schema": "rox-home-manifest-v1",
  "version": 1,
  "issue": "#1510",
  "spec": "TECH-SPEC §10.2",
  "notes": [
    "Codemod-scope entries carry mechanical from→to rules (idempotent: skipped when already applied).",
    "Manual-scope entries are structural (migrator, flag, bootstrap logic) and verify post-state markers only.",
    "Unchanged-rule-5 entries are workspace-local .rox stores (D-v2-11): paths stay, comments clarify.",
    "Frozen-history entries are dated evidence/audit docs: never rewritten, exempt from the grep gate.",
    "Existing test expectations that pin flag-OFF legacy behavior are kept as regression coverage."
  ],
  "files": [
    { "path": "packages/shared/src/config/env.ts", "mode": "manual", "markers": ["migrateHiddenRoxHome", "isStorageVisibleRootEnabled", "always `~/rox`"] },
    { "path": "packages/shared/src/config/paths.ts", "mode": "ast", "rules": [{ "from": "Default (clean install): ~/.rox/", "to": "Default: `~/rox` (visible home)" }, { "from": "Legacy configuration is imported once into ~/.rox without removing its source.", "to": "Legacy configuration is imported once without removing its source." }] },
    { "path": "packages/shared/src/config/storage.ts", "mode": "ast", "rules": [{ "from": "{configDir}/tool-icons/ (default ~/.rox or ~/rox)", "to": "{configDir}/tool-icons/ (default ~/rox)" }, { "from": "creates ~/.craft-agent/docs/", "to": "creates {configDir}/docs/" }] },
    { "path": "packages/shared/src/identity/manifest.ts", "mode": "manual", "markers": ["ROX_HOME_DIR_NAME", "ROX_COMPAT_SYMLINK_NAME"] },
    { "path": "packages/shared/src/identity/config-migration.ts", "mode": "manual", "markers": ["migrateHiddenRoxHome", "ROX_HOME_MIGRATION_MANIFEST_NAME"] },
    { "path": "packages/shared/src/agent/permissions-config.ts", "mode": "ast", "rules": [{ "from": "~/.rox", "to": "~/rox" }] },
    { "path": "packages/shared/src/sessions/import-registry.ts", "mode": "manual", "markers": ["D-v2-11"] },
    { "path": "packages/server-core/src/handlers/rpc/browser-data-auto-import.ts", "mode": "manual", "markers": ["D-v2-11"] },
    { "path": "packages/server-core/src/handlers/rpc/session-foreign-auto-import-storage.ts", "mode": "manual", "markers": ["D-v2-11"] },
    { "path": "packages/session-tools-core/src/context.ts", "mode": "ast", "rules": [{ "from": "~/.rox/workspaces/{id}", "to": "~/rox/workspaces/{id}" }, { "from": "writes JSON files to ~/.rox/feedback/", "to": "writes JSON files to {configDir}/feedback/ (~/rox/feedback/)" }] },
    { "path": "packages/session-tools-core/src/templates/loader.ts", "mode": "ast", "rules": [{ "from": "~/.rox/workspaces/ws/sources/linear", "to": "~/rox/workspaces/ws/sources/linear" }] },
    { "path": "packages/session-tools-core/src/handlers/mermaid-validate.ts", "mode": "manual", "markers": ["ctx.configDir", "docs/mermaid.md"] },
    { "path": "apps/electron/src/main/meetings/local-asr.ts", "mode": "manual", "markers": ["compat", "symlink"] },
    { "path": "apps/electron/src/main/ssh-tunnel/server-bootstrap.ts", "mode": "manual", "markers": ["REMOTE_HOME_MOVE_COMMAND", "LEGACY_ROX_REMOTE_INSTALL_DIR", "~/rox/remote-server"] },
    { "path": "apps/electron/src/main/ssh-tunnel/ssh-tunnel-manager.ts", "mode": "manual", "markers": ["~/rox/remote-server/.token"] },
    { "path": "scripts/install-app.sh", "mode": "text", "rules": [{ "from": "${ROX_CONFIG_DIR:-$HOME/.rox}", "to": "${ROX_CONFIG_DIR:-$HOME/rox}" }] },
    { "path": "scripts/verify-server-container-context.ts", "mode": "text", "rules": [{ "from": "'.craft-agent/credentials.json', '.rox/private.json'", "to": "'.craft-agent/credentials.json', 'rox/private.json', '.rox/private.json'" }] },
    { "path": "scripts/probes/omp-worker-loop.ts", "mode": "manual", "markers": ["resolveConfigDir()", "toolchain"] },
    { "path": "scripts/probes/runtime-map-native-loop.ts", "mode": "manual", "markers": ["resolveConfigDir()", "toolchain"] },
    { "path": "tests/final-readiness/rox-readiness-ui-001.seed.ts", "mode": "manual", "markers": ["resolveConfigDir()", "ROX_SEED_LEGACY_DOT_ROX"] },
    { "path": ".cursor/install.sh", "mode": "text", "rules": [{ "from": "$HOME/.rox-cloud/bun", "to": "$HOME/rox-cloud/bun" }] },
    { "path": ".cursor/start-server.sh", "mode": "text", "rules": [{ "from": "$HOME/.rox-cloud/bun", "to": "$HOME/rox-cloud/bun" }, { "from": "$HOME/.rox-cloud/context", "to": "$HOME/rox-cloud/context" }] },
    { "path": ".cursor/environment.json", "mode": "text", "rules": [{ "from": "~/.rox-cloud/context", "to": "~/rox-cloud/context" }] },
    { "path": "README.md", "mode": "text", "rules": [{ "from": "The canonical configuration directory is `~/.rox`.", "to": "The canonical configuration directory is `~/rox`." }, { "from": "~/.rox/", "to": "~/rox/" }] },
    { "path": "AGENTS.md", "mode": "text", "rules": [{ "from": "Канонический контекст: `~/.rox/context`", "to": "Канонический контекст: `~/rox/context`" }] },
    { "path": "docs/plans/2026-10-07-rox-visible-config-migration.md", "mode": "manual", "markers": ["W1-13", "#1510"] },
    { "path": "docs/mail-local-stalwart.md", "mode": "text", "rules": [{ "from": "`~/.rox/mail", "to": "`~/rox/mail" }, { "from": "in `~/.rox/mail/", "to": "in `~/rox/mail/" }] },
    { "path": "docs/cursor-cloud-server.md", "mode": "text", "rules": [{ "from": ".rox-cloud", "to": "rox-cloud" }] },
    { "path": "apps/electron/resources/docs/statuses.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/craft-cli.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/permissions.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/automations.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/sources.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/tool-icons.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/skills.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/themes.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/labels.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] },
    { "path": "apps/electron/resources/docs/browser-tools.md", "mode": "text", "rules": [{ "from": "~/.rox", "to": "{{ROX_HOME}}" }] }
  ],
  "frozenHistory": [
    "docs/plans/2026-10-07-rox-shell-cloud-platform.md",
    "docs/plans/2026-10-07-secrets-model.md",
    "docs/runtime-branding-audit.md",
    "docs/runtime-upgrades/2026-10-03-rox-cli.json",
    "docs/final-readiness/parallel-work/first-wave-web.json",
    "docs/superpowers/plans/2026-09-01-rox-desktop-finalization.md"
  ]
}
