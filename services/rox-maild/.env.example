# Copy to `.env` next to docker-compose.yml and fill in. Never commit real values.
# `openssl rand -hex 32` generates a good secret.

# Shared secret with the Cloudflare Email Worker (X-Rox-Signature, HMAC-SHA256).
MAIL_INBOUND_SECRET=

# Stalwart administrator used by the setup wizard and by /api/provision.
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=

# Mailbox domain and the JMAP URL handed back to Rox clients.
MAIL_DOMAIN=rox.one
MAIL_JMAP_URL=http://127.0.0.1:8480

# Default per-mailbox storage quota in bytes (1 GiB). Range: 256 MiB … 1 TiB.
MAIL_DEFAULT_QUOTA_BYTES=1073741824

# Host port rox-maild is published on (loopback only).
MAILD_PORT=8090

# Rox broker origin used to verify access tokens.
ROX_BROKER_URL=https://rox.one

# Optional shared token letting a server-side caller (the website drain
# worker) provision mailboxes via /api/provision without a Rox user token.
# Leave empty to disable. Generate with `openssl rand -hex 32`.
# MAIL_PROVISION_SERVICE_TOKEN=

# Public URL Stalwart publishes in its discovery documents (optional).
# STALWART_PUBLIC_URL=https://mx.rox.one

LOG_LEVEL=info