# rox-tg-bot environment.
# Copy to .env and fill in the two secrets, then: docker compose up -d --build

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Bearer token the desktop client and the site use for /api/link/*.
TG_LINK_SERVICE_TOKEN=

# Optional: pin the bot username; otherwise discovered via getMe at boot.
BOT_USERNAME=

# Optional overrides.
# PORT=8789
# TG_LINK_DB=/data/state.sqlite
# LOG_LEVEL=info