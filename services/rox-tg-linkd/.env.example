# Copy to `.env` next to docker-compose.yml and fill in. Never commit real values.

# Bot token from @BotFather. Without it the service starts, but /api/health
# answers {"ok":false,"reason":"no-token"} and /api/link/start returns 503.
TG_BOT_TOKEN=

# Bot username (without @). Optional: learned from getMe at startup. Set it to
# skip that call; deep links need it either way.
TG_BOT_USERNAME=

# Bearer token required on /api/link/* and /api/register/*. When empty the
# whole link surface refuses every call (fail-closed), so set it in every
# deployment — including a loopback-only one.
LINK_AUTH_TOKEN=

# Code lifetime (default 30 minutes) and wrong-code attempts before the pending
# link is invalidated (default 10).
LINK_TTL_MS=1800000
LINK_MAX_ATTEMPTS=10

# HTTP listen port inside the process (default 8095).
PORT=8095

# SQLite database path. :memory: disables persistence (tests only).
LINK_DB_PATH=./data/rox-tg-linkd.sqlite

# Long-polling: getUpdates timeout, first retry delay and its cap.
TG_POLL_TIMEOUT_SEC=25
TG_BACKOFF_BASE_MS=1000
TG_BACKOFF_MAX_MS=60000

# Bot API origin (override for a local Bot API server).
TG_API_BASE=https://api.telegram.org

# Host port rox-tg-linkd is published on (loopback only).
LINKD_PORT=8095

LOG_LEVEL=info